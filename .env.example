# Slab API Configuration
# Copy this file to .env and fill in your actual values

# Your Slab API token (get from https://your-team.slab.com/settings/api)
SLAB_API_TOKEN=your-api-token-here

# Your Slab team subdomain (e.g., "acme" for acme.slab.com)
SLAB_TEAM=your-team-name

# Read-only mode: set to "true" to disable write/update operations
# - Stdio server (src/index.ts) defaults to false (writes enabled)
# - HTTP server (src/server-http.ts) defaults to true (writes disabled)
# SLAB_READONLY=true
